    "check-tile-contrast": "node scripts/check-tile-contrast.mjs"
  },
  "dependencies": {
    "astro": "^5.14.1",
    "sharp": "^0.34.4"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true,
    "sharp@0.34.5": true
  }
