---
import type { ClientSite } from '../lib/schema';
import { intlPhone, mapsHref } from '../lib/format';
import '../styles/fonts.css';
import '../styles/base.css';

interface Props {
  client: ClientSite;
}
const { client } = Astro.props;
const { business, contact, location, rating, seo } = client;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const mapQuery = location.mapQuery ?? `${location.addressLine}, ${location.city}`;

/*
 * Skin lookup. Eager glob because Vite needs a literal pattern — it cannot
 * resolve `../skins/${skin}.css` from a variable. Unused skins are tree-shaken.
 */
const skins = import.meta.glob('../skins/*.css', { query: '?raw', import: 'default', eager: true });
const skinCss = skins[`../skins/${business.skin}.css`] as string | undefined;
if (!skinCss) {
  throw new Error(
    `No stylesheet for skin "${business.skin}". Expected src/skins/${business.skin}.css`
  );
}

/*
 * Schema.org LocalBusiness.
 *
 * This is the cheapest line of code in the project and one of the highest
 * value: it is what puts hours, phone and rating into the Google result
 * itself. For a business whose customers all arrive via Google search, that
 * panel is worth more than most of the page below it.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: business.name,
  description: seo.description,
  url: canonical,
  telephone: `+${intlPhone(contact.phone ?? contact.whatsapp)}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: location.addressLine,
    addressLocality: location.city,
    addressCountry: 'PK',
  },
  ...(rating
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: rating.score,
          reviewCount: rating.count,
        },
      }
    : {}),
  hasMap: mapsHref(mapQuery),
};
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="theme-color" content="#171018" />

    {/*
      Preload only the two faces the hero needs before first paint: the display
      face draws the wordmark, the body face everything under it. The 600 weight
      and the Nastaliq face appear further down the page and can arrive late —
      preloading all four would have them compete with the ones that matter.
    */}
    <link rel="preload" href="/fonts/fraunces-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dmsans-var.woff2" as="font" type="font/woff2" crossorigin />

    {/*
      Skin is chosen by the client file. Inlined rather than linked: at these
      sizes an extra request costs more than the bytes, and it removes a
      render-blocking round trip on the critical path.
    */}
    <style set:html={skinCss} />

    <script is:inline set:html={JSON.stringify(jsonLd)} type="application/ld+json" />

    <!-- Flips before first paint so reveal animations never hide content
         from a visitor with JavaScript disabled or blocked. -->
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>

  <body>
    {/*
      Shared clip paths, in objectBoundingBox units so one definition scales to
      any element. The mehrab is the pointed arch of a Mughal niche — the shape
      of a jharokha window and of the backdrop every Pakistani bride is
      photographed against. Using it to frame the photography roots the page in
      something real rather than applying a generic rounded corner.
    */}
    <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
      <defs>
        <clipPath id="mehrab" clipPathUnits="objectBoundingBox">
          <path
            d="M0,1 L0,0.45 C0,0.22 0.26,0.06 0.5,0 C0.74,0.06 1,0.22 1,0.45 L1,1 Z"
          ></path>
        </clipPath>
        <clipPath id="mehrab-soft" clipPathUnits="objectBoundingBox">
          <path
            d="M0,1 L0,0.30 C0,0.13 0.24,0.02 0.5,0 C0.76,0.02 1,0.13 1,0.30 L1,1 Z"
          ></path>
        </clipPath>
      </defs>
    </svg>

    <div class="page">
      <slot />
    </div>

    <script is:inline>
      (function () {
        var els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) {
          for (var i = 0; i < els.length; i++) els[i].classList.add('is-in');
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px' }
        );
        for (var j = 0; j < els.length; j++) io.observe(els[j]);
      })();
    </script>
  </body>
</html>
