---
import { Picture } from 'astro:assets';
import type { ClientSite } from '../lib/schema';
import { telHref } from '../lib/format';
import { waLink, enquiryMessage } from '../lib/whatsapp';
import { clientImage } from '../lib/images';
import Icon from './Icon.astro';
import Boteh from './Boteh.astro';
import Logo from './Logo.astro';

interface Props {
  client: ClientSite;
}
const { client } = Astro.props;
const { business, contact, location, rating, trust, id } = client;

const wa = waLink(contact.whatsapp, enquiryMessage(business.name));
const tel = telHref(contact.phone ?? contact.whatsapp);
const hero = clientImage(id, business.heroImage);

// Full stars only. A half-star glyph renders inconsistently across the Android
// font stack, and the numeral beside it carries the precision anyway.
const stars = '★'.repeat(Math.round(rating?.score ?? 0));
---

<header class={hero ? 'hero hero--image' : 'hero'}>
  {
    hero && (
      <div class="hero__media">
        <Picture
          src={hero}
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          widths={[470, 940]}
          sizes="(max-width: 470px) 100vw, 470px"
          alt={business.heroAlt ?? `${business.name}, ${location.area}`}
          /* The one image on the page that must not lazy-load: it is the
             largest contentful paint. */
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    )
  }

  <div class="hero__body">
    <Logo class="hero__crest" size={44} />

    <h1 class="hero__name">{business.name}</h1>
    <p class="hero__kicker">{business.tagline}</p>

    {/* Two botehs turned to face each other, the way the motif is laid out on
        a dupatta border — the mirrored pair is the traditional arrangement. */}
    <div class="rule" aria-hidden="true">
      <i></i>
      <Boteh class="rule__mark" size={17} flip />
      <Boteh class="rule__mark" size={17} />
      <i></i>
    </div>

    {business.nameUrdu && <p class="urdu hero__urdu">{business.nameUrdu}</p>}

    <p class="hero__place">
      {location.area}, {location.city}{business.established && ` · Est. ${business.established}`}
    </p>

    {
      rating && (
        <p class="rating">
          <span class="rating__stars" aria-hidden="true">{stars}</span>
          <b>{rating.score}</b>
          <span aria-hidden="true">·</span>
          <span><b>{rating.count}</b> reviews</span>
        </p>
      )
    }

    <div class="hero__cta">
      <a class="btn btn--primary" href={wa} rel="noopener">
        <Icon name="whatsapp" />
        Book now
      </a>
      <a class="btn btn--ghost" href={tel}>
        <Icon name="phone" />
        Call us
      </a>
    </div>

    {
      trust && trust.length > 0 && (
        <div class="trust">
          {trust.map((t) => (
            <span>{t}</span>
          ))}
        </div>
      )
    }
  </div>
</header>
