---
/**
 * Boteh — the paisley.
 *
 * Replaces the four-point sparkle that was standing in as a crest. The sparkle
 * is the default decorative glyph of every AI-generated layout and says nothing
 * about this business; the boteh is the single most recognisable motif in
 * mehndi, block printing and Kashmiri embroidery, and a bride has one drawn on
 * her hands the week she books.
 *
 * Drawn as an open stroke with an inner echo and three spine dots, the way it
 * is actually applied with a henna cone — a filled silhouette would read as a
 * logo stamp instead of a hand.
 */
interface Props {
  size?: number;
  class?: string;
  /** Rotate the curl; the motif is directional and repeats better mirrored. */
  flip?: boolean;
}
const { size = 40, class: cls = '', flip = false } = Astro.props;
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 44 44"
  fill="none"
  aria-hidden="true"
  focusable="false"
  style={flip ? 'transform: scaleX(-1)' : undefined}
>
  <path
    d="M22 40.5C12 35.5 7.5 26.5 9.5 18.2 11.6 9.4 18.8 3.8 26 3.8c7 0 11.2 5.6 10.4 12.6-.7 6.6-6.2 10.8-11.4 9.4-3.8-1-4.6-5.2-2.4-7.4"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
  <path
    d="M22 34.6c-6.4-3.8-8.6-9.8-7-15.6 1.6-6 6.2-9.6 11-9.6 4.6 0 7.2 3.6 6.8 8.2-.4 4.2-3.6 6.8-6.6 5.9"
    stroke="currentColor"
    stroke-width="1"
    stroke-linecap="round"
    opacity="0.5"
  ></path>
  <circle cx="22" cy="30.5" r="1.05" fill="currentColor" opacity="0.75"></circle>
  <circle cx="19.4" cy="25.6" r="0.85" fill="currentColor" opacity="0.55"></circle>
  <circle cx="18" cy="20.4" r="0.7" fill="currentColor" opacity="0.4"></circle>
</svg>
